# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
ENABLE_JOBS=false

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/database
DIRECT_URL=postgresql://user:password@host/database

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Application secrets
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=15m
REFRESH_SECRET=replace_with_a_different_long_random_secret
REFRESH_EXPIRY=30d

# EmailJS
EmailJs_API_KEY=your_emailjs_public_key
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAIL_FROM=noreply@example.com

# PayFast Sandbox
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=your_payfast_merchant_key
PAYFAST_PASSPHRASE=your_payfast_passphrase
PAYFAST_SANDBOX=true

# South African Reserve Bank rates
SARB_API_URL=https://custom.resbank.co.za/SarbWebApi/WebIndicators/
